CLIENT_URL=http://localhost:3000
PORT=5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Phase 1 GitHub connection: the explicit "Connect GitHub" (Better Auth
# linkSocial) flow requests the `repo` scope for repository discovery,
# private read, push and PR support. Scope constant lives in
# src/modules/github/github.constants.ts (GITHUB_REPO_SCOPE). Plain
# GitHub sign-in stays minimal (read:user, user:email). No env change needed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# AI providers (Phase 1). Default provider + model, per-request overridable.
AI_PROVIDER=ollama
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b