CLIENT_URL=http://localhost:3000
PORT=5000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DATABASE_URL=

# AI providers (Phase 1). Default provider + model, per-request overridable.
AI_PROVIDER=ollama
AI_DEFAULT_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Redis cache (local or cloud). App works without it (graceful cache-miss fallback).
REDIS_URL=

# Cloudinary avatars (server-only secret; never expose to browser).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional GitHub token fallback for import (per-user OAuth preferred).
GITHUB_TOKEN=