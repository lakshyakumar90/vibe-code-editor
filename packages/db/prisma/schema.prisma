generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  projects   Project[]
  membership ProjectMember[]
  favorites  ProjectFavorite[]

  githubConnection GitHubConnection?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Phase 1 (GitHub connection): product-state metadata for a user's GitHub
// authorization. NEVER stores raw tokens — the OAuth access token remains
// owned by Better Auth's Account model. Server derives identity from the
// session (userId) + GitHub API; client input is never trusted for linkage.
model GitHubConnection {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  githubUserId String
  login        String
  avatarUrl    String?
  name         String?
  email        String?

  // Granted-scope snapshot (e.g. "read:user,user:email,repo"), informational.
  scope  String?
  // "connected" | "needs_reconnect"
  status String @default("connected")

  connectedAt     DateTime @default(now())
  lastValidatedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([githubUserId])
  @@index([userId])
  @@map("github_connection")
}

model Project {
  id          String  @id @default(cuid())
  name        String
  description String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template Template
  templateVersion String @default("1.0.0")
  
  members ProjectMember[]
  files   File[]
  messages Message[]
  favorites ProjectFavorite[]

  aiConversations AIConversation[]
  aiPlans         AIPlan[]
  aiRuns          AIRun[]
  changeSets      ChangeSet[]

  gitRepository GitRepository?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

// Phase 3 (GitHub import): 1:1 binding between an IDE project and the
// remote GitHub repository it was imported from. Records remote identity
// and the imported revision only — NEVER commits, diffs, Git objects,
// branch history, or credentials. The OAuth token stays in Account.
model GitRepository {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Null for local-only repositories (initialized via Source Control on
  // a project that was never imported from GitHub). GitHub-imported
  // projects always carry the full binding.
  githubRepoId String?
  owner        String?
  repo         String?
  fullName     String?

  defaultBranch String
  currentBranch String

  importedSha String?

  private  Boolean @default(false)
  canRead  Boolean @default(false)
  canWrite Boolean @default(false)
  canAdmin Boolean @default(false)

  // Phase 4A: server-side worktree lifecycle. Null until the persistent
  // Git repository has been bootstrapped from the project's File rows.
  initializedAt DateTime?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([githubRepoId])
  @@index([fullName])
  @@map("git_repository")
}

enum Template {
  REACT
  VUE
  HONO
  EXPRESS
  NEXTJS
  ANGULAR
}

model ProjectMember {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      ProjectRole @default(EDITOR)
  createdAt DateTime    @default(now())

  //This prevents the same user from being added to the same project twice.
  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

model ProjectFavorite {
  id        String @id @default(cuid())
  projectId String
  userId    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // One star per user per project.
  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_favorite")
}

model File {
  id   String @id @default(cuid())
  name String

  path    String
  content String? @db.Text

  isFolder Boolean @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?
  parent   File? @relation("FileTree", fields: [parentId], references:  [id], onDelete: Cascade)
  children File[] @relation("FileTree")

  // Last-modified-by tracking (server-derived authenticated user id).
  // Set on human saves and AI-changeset applies; null for older rows.
  updatedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //This means a project cannot have two files with the same path.
  @@unique([projectId, path])
  @@index([projectId])
  @@index([projectId, parentId])
}

model Message {
  id String @id @default(cuid())
  content String
  projectId String
  role String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

model AIConversation {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  title     String?
  mode      String @default("ask")

  messages AIMessage[]
  plans    AIPlan[]
  runs     AIRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, userId])
  @@index([projectId, updatedAt])
}

model AIMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
}

model AIPlan {
  id             String @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  status         String @default("pending")
  steps          Json   @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, userId])
  @@index([conversationId])
}

model AIRun {
  id             String  @id @default(cuid())
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  mode           String
  status         String @default("running")

  changeSets ChangeSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, userId])
  @@index([conversationId])
}

enum ChangeSetStatus {
  pending
  applied
  rejected
}

model ChangeSet {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runId     String?
  run       AIRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  userId    String
  status    ChangeSetStatus @default(pending)
  changes   Json

  resolvedAt DateTime?
  resolvedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, status])
  @@index([runId])
}
